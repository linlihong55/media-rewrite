# 复制本文件为 .env.local 并填入自己的配置。.env.local 已被 .gitignore 忽略，不会上传。

# ===== 改写模型 =====
# claude = 用本机 claude CLI（Claude Code 订阅账号，无需 API Key，默认）
# deepseek = 用 DeepSeek API；主通道失败会自动降级到另一个
REWRITE_PROVIDER=claude
# 想指定 Claude 模型时打开（默认用账号默认模型）
#CLAUDE_MODEL=sonnet

# DeepSeek 备用通道（在 https://platform.deepseek.com 创建 API Key）
#DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 小红书解析（可选） =====
# 小红书笔记默认匿名抓取（链接需带 xsec_token，浏览器地址栏复制的都有）。
# 如果频繁提示被风控拦截，把浏览器里 xiaohongshu.com 的 Cookie 整串粘贴到这里：
# 自动发现流程的小红书关键词搜索（e2e/search-xhs.mjs）也会读取这个变量。
#XHS_COOKIE=

# ===== 抖音关键词搜索（自动发现功能必需，见 PRD 第 9 节） =====
# 和上面「解析已知链接」用的游客 Cookie（存在 vendor/.../config.yaml 里，会自动刷新）不是一回事：
# 抖音搜索接口要求真实登录态，游客 Cookie 会被拒绝（提示「请先登录，再继续搜索吧」）。
# 获取方式：浏览器登录抖音网页版（www.douyin.com）后，把 Cookie 整串复制到这里；
# 失效了同样需要重新登录复制，没有自动刷新脚本。
#DOUYIN_LOGIN_COOKIE=

# ===== 飞书多维表格同步 =====
# 方式一（推荐，个人使用最简单）：多维表格授权码
# 打开你的多维表格 → 右上角「···」→「更多」→「开发工具」→ 生成 Personal Base Token
#FEISHU_PERSONAL_BASE_TOKEN=
# 多维表格的浏览器地址，形如 https://xxx.feishu.cn/base/XXXXXXXX?table=tblxxx
# （用 /base/ 开头的链接，不要用 /wiki/ 链接；不带 ?table= 时程序会自动建一张字段匹配的表）
FEISHU_BITABLE_URL=

# 手机悬浮助手访问令牌（至少 32 个随机字符，仅保存在 Mac 和个人手机）
# 可用 `openssl rand -hex 32` 生成；不要提交真实令牌。
MOBILE_API_TOKEN=

# 方式二（备选）：企业自建应用
# 飞书开放平台 https://open.feishu.cn → 创建企业自建应用 → 开通多维表格权限并发布
# 然后把你的多维表格通过「···」→「添加文档应用」授权给这个应用
#FEISHU_APP_ID=
#FEISHU_APP_SECRET=

# ===== PostgreSQL（阶段 A 主数据库） =====
# 本项目 docker-compose.yml 的本地默认连接；生产环境请更换密码并使用独立数据库。
DATABASE_URL=postgresql://creator:creator_local@127.0.0.1:54329/creator_os
